# Copie este arquivo para ".relatos-admin.env" (mesma pasta) preenchendo com a service role key
# do projeto (Supabase Dashboard → Project Settings → API → "service_role", não a "anon").
#
# NUNCA preencher isso diretamente aqui ou colar a chave numa mensagem de chat: ela dá acesso
# TOTAL ao banco, ignorando toda política de RLS. O arquivo ".relatos-admin.env" já está no
# .gitignore. Prefira gerar o arquivo por um comando de terminal que você mesmo roda, ex.:
#
#   read -s -p "Service role key: " K && echo "SUPABASE_SERVICE_ROLE_KEY=$K" > ferramentas/.relatos-admin.env && unset K
#
# assim a chave nunca aparece na conversa com o Claude nem no histórico do shell.
SUPABASE_SERVICE_ROLE_KEY=
